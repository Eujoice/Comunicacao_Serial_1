int sw1 = 8;
int led = 13;
bool ligado = false;
bool ultimo = HIGH;
char msg;

// variaveis para piscar sem travar o loop
bool piscando = false;
bool ledState = false;
unsigned long ultimoPisca = 0;

void setup() {
  pinMode(sw1, INPUT_PULLUP);
  pinMode(led, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  // ao soltar SW1, manda toggle pro Arduino 2
  bool atual = digitalRead(sw1);
  if (ultimo == LOW && atual == HIGH) {
    Serial.print("T");
  }
  ultimo = atual;

  // le todas as mensagens e fica so com a ultima
  char ultimaMsg = 0;
  while (Serial.available()) {
    ultimaMsg = Serial.read();
  }

  // verifica a ultima mensagem recebida
  if (ultimaMsg == 'P') {
    piscando = true;
  }
  if (ultimaMsg == 'R') {
    piscando = false;
    digitalWrite(led, LOW);
    ledState = false;
  }

  // se passou tempo suficiente, troca o estado do led
  if (piscando == true) {
    digitalWrite(13, (millis() / 250) % 2);
  }
}
