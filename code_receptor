int sw2 = 8;
int led = 13;
bool ligado = false;
char msg;

void setup() {
  pinMode(sw2, INPUT_PULLUP);
  pinMode(led, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  // recebe toggle do Arduino 1
  if (Serial.available()) {
    msg = Serial.read();
    if (msg == 'T') {
      ligado = !ligado;
      digitalWrite(led, ligado);
    }
  }

  // envia estado do SW2 pro Arduino 1
  if (digitalRead(sw2) == LOW) {
    Serial.print("P");
  } else {
    Serial.print("R");
  }

  delay(100);
}
